model split_merge_counter_8

qubits q0, q1, q2, q3, q4, q5, q6, q7
gates CX, X
state s0 initial {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s1 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s2 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u01: q0, q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s3 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u012: q0, q1, q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s4 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u012: q0, q1, q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s5 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u012: q0, q1, q2
    u3: q3
    u45: q4, q5
    u6: q6
    u7: q7
  }
}

state s6 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u012: q0, q1, q2
    u3: q3
    u456: q4, q5, q6
    u7: q7
  }
}

transition t000_x: s0 -> s1 {
  X(q0)
}

transition t001_cx: s1 -> s2 {
  CX(q0, q1)
}

transition t002_cx: s2 -> s3 {
  CX(q1, q2)
}

transition t003_x: s3 -> s4 {
  X(q4)
}

transition t004_cx: s4 -> s5 {
  CX(q4, q5)
}

transition t005_cx: s5 -> s6 {
  CX(q5, q6)
}

trace main {
  a0: s0 initial
  a0 --t000_x--> a1: s1
  a1 --t001_cx--> a2: s2
  a2 --t002_cx--> a3: s3
  a3 --t003_x--> a4: s4
  a4 --t004_cx--> a5: s5
  a5 --t005_cx--> f6: terminal s6
}

execution run_main {
  trace main
}

property p_split_merge_basis_probability distribution {
  anchors f6
  observe dist(q0, q1, q2, q3, q4, q5, q6, q7, Z)
  expect {(1, 1, 1, 0, 1, 1, 1, 1): 1}
}
