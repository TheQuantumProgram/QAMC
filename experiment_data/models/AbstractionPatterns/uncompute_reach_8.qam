model uncompute_reach_8

qubits q0, q1, q2, q3, q4, q5, q6, q7
gates CCX, CX, H
state s0 initial {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s1 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s2 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u01: q0, q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s3 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u012: q0, q1, q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s4 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u01: q0, q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s5 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s6 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

transition t000_h: s0 -> s1 {
  H(q0)
}

transition t001_cx: s1 -> s2 {
  CX(q0, q1)
}

transition t002_ccx: s2 -> s3 {
  CCX(q0, q1, q2)
}

transition t003_ccx: s3 -> s4 {
  CCX(q0, q1, q2)
}

transition t004_cx: s4 -> s5 {
  CX(q0, q1)
}

transition t005_h: s5 -> s6 {
  H(q0)
}

trace main {
  a0: s0 initial
  a0 --t000_h--> a1: s1
  a1 --t001_cx--> a2: s2
  a2 --t002_ccx--> a3: s3
  a3 --t003_ccx--> a4: s4
  a4 --t004_cx--> a5: s5
  a5 --t005_h--> f6: terminal s6
}

execution run_main {
  trace main
}

property p_midway_mark_reachable reachability {
  anchors a0, a1, a2, a3, a4, a5, f6
  mode pointwise_any
  observe dist(q2, Z)
  expect 1
  threshold 0
}
