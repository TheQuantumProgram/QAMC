model uncompute_counter_8

qubits q0, q1, q2, q3, q4, q5, q6, q7
gates CCX, CX
state s0 initial {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s1 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u01: q0, q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s2 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u012: q0, q1, q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s3 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u01: q0, q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

state s4 {
  active q0, q1, q2, q3, q4, q5, q6, q7
  units {
    unit_completion singletons
    u0: q0
    u1: q1
    u2: q2
    u3: q3
    u4: q4
    u5: q5
    u6: q6
    u7: q7
  }
}

transition t000_cx: s0 -> s1 {
  CX(q0, q1)
}

transition t001_ccx: s1 -> s2 {
  CCX(q0, q1, q2)
}

transition t002_ccx: s2 -> s3 {
  CCX(q0, q1, q2)
}

transition t003_cx: s3 -> s4 {
  CX(q0, q1)
}

trace main {
  a0: s0 initial
  a0 --t000_cx--> a1: s1
  a1 --t001_ccx--> a2: s2
  a2 --t002_ccx--> a3: s3
  a3 --t003_cx--> f4: terminal s4
}

execution run_main {
  trace main
}

property p_midway_mark_reachable reachability {
  anchors a0, a1, a2, a3, f4
  mode pointwise_any
  observe dist(q2, Z)
  expect 1
  threshold 0
}
