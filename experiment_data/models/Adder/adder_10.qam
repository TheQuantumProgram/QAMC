  a25 --t025_cx--> a26: s26
  a26 --t026_ccx--> a27: s27
  a27 --t027_cx--> a28: s28
  a28 --t028_cx--> f29: terminal s29
}

execution run_main {
  trace main
}

property p_adder_output_probability_q0 reachability {
  anchors f29
  mode pointwise_any
  observe dist(q0, Z)
  expect 0
  threshold 0.999999
}

