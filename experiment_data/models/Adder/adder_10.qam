trace main {
  a0: s0 initial
  a0 --t000_x--> a1: s1
  a1 --t001_x--> a2: s2
  a2 --t002_x--> a3: s3
  a3 --t003_x--> a4: s4
  a4 --t004_cx--> a5: s5
