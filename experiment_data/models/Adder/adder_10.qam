  a13 --t013_cx--> a14: s14
  a14 --t014_cx--> a15: s15
  a15 --t015_ccx--> a16: s16
  a16 --t016_cx--> a17: s17
  a17 --t017_ccx--> a18: s18
  a18 --t018_cx--> a19: s19
  a19 --t019_cx--> a20: s20
