  a22 --t022_h--> f23: terminal s23
}

execution run_main {
  trace main
}

property p_bv_hidden_string_probability_q0 reachability {
  anchors f23
  mode pointwise_any
  observe dist(q0, Z)
  expect 1
  threshold 0.999999
}

