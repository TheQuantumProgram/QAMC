model fanout_focus_root

qubits q0..q3
gates H, CX

state S0 initial {
  active q0..q3
}

state S01 {
  active q0..q3
  units {
    unit_completion singletons
    u01: q0, q1
    q2: q2
    q3: q3
  }
}

state S012 {
  active q0..q3
  units {
    unit_completion singletons
    u012: q0, q1, q2
    q3: q3
  }
}

state S_star {
  active q0..q3
  units {
    unit_completion singletons
    u01: q0, q1
    u02: q0, q2
    u03: q0, q3
  }
}

transition t_h0: S0 -> S0 {
  H(q0)
}

transition t_cx01: S0 -> S01 {
  CX(q0, q1)
}

transition t_cx02: S01 -> S012 {
  CX(q0, q2)
}

transition t_cx03: S012 -> S_star {
  CX(q0, q3)
}

trace main {
  a0: S0 initial
  a0 --t_h0--> a1: S0
  a1 --t_cx01--> a2: S01
  a2 --t_cx02--> a3: S012
  a3 --t_cx03--> f4: terminal S_star
}

execution run_main {
  trace main
}

property p_fanout_root_relation relation {
  anchors f4
  observe dist(q0, q1, q2, q3, Z)
  expect equal_bits
}

property p_fanout_root_distribution distribution {
  anchors f4
  observe dist(q0, q1, q2, q3, Z)
  expect {(0,0,0,0): 0.5, (1,1,1,1): 0.5}
}
