model transient_bridge_burst

qubits q0..q5
gates H, CX

state S0 initial {
  active q0..q5
}

state S01 {
  active q0..q5
  units {
    unit_completion singletons
    u01: q0, q1
    q2: q2
    q3: q3
    q4: q4
    q5: q5
  }
}

state S01_45 {
  active q0..q5
  units {
    unit_completion singletons
    u01: q0, q1
    q2: q2
    q3: q3
    u45: q4, q5
  }
}

state S12_45 {
  active q0..q5
  units {
    unit_completion singletons
    u01: q0, q1
    u12: q1, q2
    q3: q3
    u45: q4, q5
  }
}

state S23_45 {
  active q0..q5
  units {
    unit_completion singletons
    u01: q0, q1
    u12: q1, q2
    u23: q2, q3
    u45: q4, q5
  }
}

state S34_45 {
  active q0..q5
  units {
    unit_completion singletons
    u01: q0, q1
    u12: q1, q2
    u23: q2, q3
    u34: q3, q4
    u45: q4, q5
  }
}

transition t_h0: S0 -> S0 {
  H(q0)
}

transition t_cx01: S0 -> S01 {
  CX(q0, q1)
}

transition t_h4: S01 -> S01 {
  H(q4)
}

transition t_cx45: S01 -> S01_45 {
  CX(q4, q5)
}

transition t_cx12: S01_45 -> S12_45 {
  CX(q1, q2)
}

transition t_cx23: S12_45 -> S23_45 {
  CX(q2, q3)
}

transition t_cx34: S23_45 -> S34_45 {
  CX(q3, q4)
}

trace main {
  a0: S0 initial
  a0 --t_h0--> a1: S0
  a1 --t_cx01--> a2: S01
  a2 --t_h4--> a3: S01
  a3 --t_cx45--> a4: S01_45
  a4 --t_cx12--> a5: S12_45
  a5 --t_cx23--> a6: S23_45
  a6 --t_cx34--> f7: terminal S34_45
}

execution run_main {
  trace main
}

property p_focus_pair_preserved relation {
  anchors f7
  observe dist(q0, q1, Z)
  expect equal_bits
}

property p_focus_pair_distribution distribution {
  anchors f7
  observe dist(q0, q1, Z)
  expect {(0,0): 0.5, (1,1): 0.5}
}
